from bs4 import BeautifulSoup
import requests

def url_checker(url_req):
        if url_req.status_code >= 100 and url_req.status_code <= 199:
            return f"Informational Response: {url_req.status_code}"
        elif url_req.status_code >= 200 and url_req.status_code <= 299:
            return f"Successful Response: {url_req.status_code}"
        elif url_req.status_code >= 300 and url_req.status_code <= 399:
            return f"Client Error Responses: {url_req.status_code}"
        elif url_req.status_code >= 400 and url_req.status_code <= 499:
            return f"Server Error Responses: {url_req.status_code}"
        else:
            return "Invalid!"

def scrapping_scrape_this_site(url_req, url):
        soup = BeautifulSoup(url_req.text, "lxml")

        page_result = []

        scrape_page_link = soup.find_all("div", class_="page")

        print(f"This has {len(scrape_page_link)} content")

        for x in (scrape_page_link):
            url_pages = url.replace("/pages/", "") + x.a['href']
            page_result.append(url_pages)

            print(f"{x.h3.text.strip()}")
            print(x.p.text.strip())
            print(f"URL: {url_pages}")
            print()

        return page_result

def scrapping_countries_of_the_world(url):

    result = []
     
    soup = BeautifulSoup(url.text, "lxml")
     
    country = soup.find_all("div", class_="country")


    for x in country:

        details = {}

        country_name = x.h3.text.strip()

        country_info = x.find("div", class_= "country-info")

        country_capital = country_info.find("span", class_= "country-capital")

        country_population = country_info.find("span", class_= "country-population")

        country_area = country_info.find("span", class_= "country-area")
        
        strong_elem = country_info.find_all("strong")

        details["country_name"] = country_name.upper()
        details[strong_elem[0].text.replace(":","")] = country_capital.text.upper()
        details[strong_elem[1].text.replace(":","")] = country_population.text
        details[strong_elem[2].text.replace(":","")] = country_area.text

        result.append(details)


    ## MAKING TABLE

    # Extract headers
    headers = result[0].keys()

    # Define column widths (match the actual keys in the data)
    column_widths = {
        'country_name': 45,
        'Capital': 30,
        'Population': 30,
        'Area (km2)': 30
    }

    # Print the table headers with proper alignment
    header_row = " | ".join(key.ljust(column_widths[key]) for key in headers)
    print(header_row)
    print("-" * len(header_row))

    # Print each row with proper alignment
    for row in result:
        print(" | ".join(str(row[key]).ljust(column_widths[key]) for key in headers))


